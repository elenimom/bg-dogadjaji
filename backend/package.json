{
  "name": "bg-events-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "node --test",
    "db:migrate": "node --env-file=../.env scripts/migrate.js",
