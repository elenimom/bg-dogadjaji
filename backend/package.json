    "db:role": "node --env-file=../.env scripts/set-role.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "express-rate-limit": "^8.0.0",
    "swagger-ui-dist": "^5.0.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
